# GENERATED FILE - DO NOT EDIT BY HAND.
#
# Source of truth: src/config/env-manifest.ts
# Regenerate:      npx tsx scripts/env-manifest.mts --write
#
# CI runs `--check`, which fails when the code reads a variable this file
# does not mention. Editing this file by hand is therefore pointless: the
# next regeneration overwrites it.
#
# STANDING UP A NEW TENANT
# ------------------------
# Fill in every REQUIRED entry, then the groups for the integrations and
# features that tenant actually has. A tenant with integrations.elks =
# false needs none of the 46elks group.
#
# NEVER copy another tenant's .env.local (ground rule R5). Every credential
# here is per customer, and a copied file makes one customer authenticate as
# another against Stripe, GA4, Google Ads, PostHog and the S3 export.
# Generate a FRESH ENCRYPTION_KEY and CRON_SECRET per tenant: the existing
# ones decrypt Wrenchlane's mail tokens.

# 107 variables: 7 required, 33 required for a group, 65 optional, 2 platform-injected.

# ==========================================================================
# Which customer this deployment is
# gate: core
# ==========================================================================
# Selects the compiled config in src/config/tenants/. An unknown value fails
# the boot on purpose rather than quietly serving one customer's domains and
# copy to another.

# Blank means wrenchlane, which is the default tenant.
# [optional]
TENANT_SLUG=            # blank | wrenchlane

# ==========================================================================
# Core: the app does not work without these
# gate: core
# ==========================================================================
# Every tenant needs all of these, and every one of them is per tenant.

# This tenant's own Supabase project URL.
# [REQUIRED]
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key for that project. Safe in the browser.
# [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server only, never exposed, never shared between tenants.
# [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment. Tracking pixels, unsubscribe links and
# OAuth callbacks are built from it, so a wrong value silently breaks all
# three.
# [REQUIRED]
NEXT_PUBLIC_APP_URL=            # https://crm-for-saas.vercel.app

# AES-256-GCM key for stored mail tokens. GENERATE A FRESH ONE PER TENANT
# (openssl rand -hex 32): the existing one decrypts Wrenchlane's tokens.
# [REQUIRED]
ENCRYPTION_KEY=

# Bearer token Vercel injects on scheduled requests. Fresh per tenant
# (openssl rand -hex 32).
# [REQUIRED]
CRON_SECRET=

# Separate secret for the data-sync and security-scan routes. Falls back to
# CRON_SECRET when unset.
# [optional]
SYNC_SECRET=

# Dedicated click/open tracking domain, kept off the app domain so tracking
# traffic cannot hurt its reputation. Falls back to NEXT_PUBLIC_APP_URL.
# [optional]
TRACKING_DOMAIN=

# ==========================================================================
# Anthropic
# gate: core
# ==========================================================================
# Reply drafting, cold-email generation, call summaries and the article
# studio all run through this. It is the primary AI provider. Gemini below
# is the fallback: set both and a credit or capacity failure here fails over
# instead of taking every AI surface down at once.

# Claude API key.
# [REQUIRED]
ANTHROPIC_API_KEY=

# ==========================================================================
# Gemini (fallback AI provider)
# gate: optional
# ==========================================================================
# Google's Generative Language API, billed to the Google account that holds
# the AI credits (jacob@wrenchlane.com, project crm-for-saas-491113). An
# exhausted Anthropic credit balance returns HTTP 400, not a 401 or a 429,
# so it does not read as a quota problem, and because credits are org-wide
# it took all ~20 AI call sites down at once (2026-07-02 and 2026-08-27).
# With GEMINI_API_KEY set, src/lib/ai/provider.ts fails those requests over
# to Gemini. Leave it blank and behaviour is exactly as before: Anthropic
# only. Verify a key with `node scripts/test-gemini.mjs`. NOT covered by the
# fallback, because Gemini's equivalents are a different contract:
# web-search enrichment (find-website, find-phone) and the article
# generator's prompt caching.

# API key from https://aistudio.google.com/apikey (pick the "CRM for SaaS"
# project so usage bills against the work account).
# [optional]
GEMINI_API_KEY=

# Alias for GEMINI_API_KEY, the name AI Studio copies out.
# [optional]
GOOGLE_AI_API_KEY=

# Which provider is tried first: anthropic (default) or gemini. Flip to
# gemini to spend Google credits ahead of Anthropic ones.
# [optional]
AI_PRIMARY_PROVIDER=

# Set to 1 to attempt only the primary provider and never fail over.
# [optional]
AI_FALLBACK_DISABLED=

# Gemini model for haiku-class call sites. Defaults to gemini-3.6-flash.
# Note gemini-2.5-* are retired for new keys: they still appear in the model
# list but every call 404s.
# [optional]
GEMINI_MODEL=

# Gemini model for call sites that ask Anthropic for a sonnet/opus-class
# model. Defaults to gemini-pro-latest, an alias rather than a pinned
# version because the only concrete pro model is a preview.
# [optional]
GEMINI_MODEL_STRONG=

# ==========================================================================
# Google mail (mail.defaultProvider = google)
# gate: mail.defaultProvider === 'google'
# ==========================================================================
# The Gmail API OAuth client, used to send and sync mail. Separate from
# Supabase Auth sign-in. A Microsoft tenant needs none of this; it needs the
# Entra registration in docs/plans/productisation/ENTRA-APP-SETUP.md
# instead.

# OAuth client id from Google Cloud Console.
# [required for this group]
GOOGLE_CLIENT_ID=

# OAuth client secret.
# [required for this group]
GOOGLE_CLIENT_SECRET=

# ==========================================================================
# Control plane
# gate: core
# ==========================================================================
# The first two are set on TENANT deployments to pull feature flags. Leave
# both blank and the tenant runs on compiled defaults, which is a supported
# state. The rest are set ONLY on the control-plane deployment itself.

# Where this tenant pulls its flags from.
# [optional]
CONTROL_PLANE_URL=            # https://jacobs-crm-control.vercel.app

# Token scoped to this tenant. Minted in the console, shown once.
# [optional]
CONTROL_PLANE_TOKEN=

# Set to 1 on the control-plane deployment ONLY. Anywhere else every /admin
# route 404s.
# [optional]
IS_CONTROL_PLANE=            # 1 on the console, blank elsewhere

# The CONTROL-PLANE project. Named differently from the tenant Supabase
# variables so a copied env file cannot point the console at a customer CRM.
# [required for this group]
CONTROL_PLANE_SUPABASE_URL=

# Service role key for the control-plane project only.
# [required for this group]
CONTROL_PLANE_SERVICE_ROLE_KEY=

# Super admins, comma separated. EXACT addresses only: a leading @domain
# entry is dropped, because @gmail.com would admit the entire internet.
# [required for this group]
CONTROL_PLANE_ADMIN_EMAILS=

# ==========================================================================
# MillionVerifier (integrations.millionverifier)
# gate: integrations.millionverifier
# ==========================================================================
# Address verification before sending. Worth knowing: unverified addresses
# silently pause enrollments, so a tenant that skips this sees contacts sit
# inert with no visible error.

# API key.
# [required for this group]
MILLIONVERIFIER_API_KEY=

# ==========================================================================
# Apify (integrations.apify)
# gate: integrations.apify
# ==========================================================================
# Google Maps scraping and Reddit harvesting. Needed by discovery and
# forums.

# API token.
# [required for this group]
APIFY_TOKEN=

# ==========================================================================
# 46elks telephony (integrations.elks)
# gate: integrations.elks
# ==========================================================================
# Outbound calling and the browser softphone. A tenant with elks: false
# needs none of these ten.

# API username.
# [required for this group]
ELKS_API_USERNAME=

# API password.
# [required for this group]
ELKS_API_PASSWORD=

# Shared secret in the call-webhook URLs. The webhooks FAIL CLOSED when
# unset, to stop spoofed inbound/hangup calls. Fresh per tenant.
# [required for this group]
CALL_WEBHOOK_SECRET=

# Fallback caller ID when no workspace setting is present.
# [optional]
CRM_CALL_FROM_NUMBER=

# SIP username for the browser softphone.
# [required for this group]
ELKS_WEBRTC_USERNAME=

# SIP password.
# [required for this group]
ELKS_WEBRTC_PASSWORD=

# SIP host.
# [required for this group]
ELKS_WEBRTC_SIP_HOST=

# WebSocket URI for SIP over WSS.
# [required for this group]
ELKS_WEBRTC_WS_URI=

# The number the softphone presents.
# [required for this group]
ELKS_WEBRTC_NUMBER=

# User whose browser the softphone rings.
# [optional]
ELKS_WEBRTC_OWNER_USER_ID=

# Override the default STUN/TURN list.
# [optional]
ELKS_WEBRTC_ICE_SERVERS=

# ==========================================================================
# Deepgram (integrations.deepgram)
# gate: integrations.deepgram
# ==========================================================================
# Call transcription. A missing key surfaces as a 401 mid-call, not at boot.

# API key.
# [required for this group]
DEEPGRAM_API_KEY=

# ==========================================================================
# ElevenLabs (integrations.elevenlabs)
# gate: integrations.elevenlabs
# ==========================================================================
# The voice agent behind the call agent feature.

# API key.
# [required for this group]
ELEVENLABS_API_KEY=

# ==========================================================================
# Google Maps (integrations.googleMaps)
# gate: integrations.googleMaps
# ==========================================================================
# Field routes and phone enrichment.

# Server-side key with Routes + Geocoding + Maps JavaScript enabled. DO NOT
# expose it on a NEXT_PUBLIC_ name.
# [required for this group]
GOOGLE_MAPS_API_KEY=

# Separate browser key, HTTP-referrer restricted.
# [required for this group]
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Default origin for the route generator.
# [optional]
ROUTE_DEFAULT_ORIGIN_ADDRESS=

# Latitude of that origin.
# [optional]
ROUTE_DEFAULT_ORIGIN_LAT=

# Longitude of that origin.
# [optional]
ROUTE_DEFAULT_ORIGIN_LNG=

# ==========================================================================
# Slack (integrations.slack)
# gate: integrations.slack
# ==========================================================================
# Alerting and bug reports. All optional: with none set, alerts fall back to
# console.error rather than failing.

# Security and sync-health alerts.
# [optional]
SLACK_ALERT_WEBHOOK_URL=

# Bot token, for posting as the app rather than a webhook.
# [optional]
SLACK_BOT_TOKEN=

# Verifies inbound Slack requests. Required if any Slack route is exposed.
# [optional]
SLACK_SIGNING_SECRET=

# Where in-app bug reports go.
# [optional]
SLACK_BUG_REPORTS_WEBHOOK_URL=

# Forum post notifications.
# [optional]
SLACK_FORUM_POSTS_WEBHOOK_URL=

# Channel id for those notifications.
# [optional]
SLACK_FORUM_POSTS_CHANNEL_ID=

# Who to @-mention on a forum hit.
# [optional]
SLACK_FORUM_TEAM_MENTIONS=

# Switchboard/voice-agent notifications.
# [optional]
SLACK_SWITCHBOARD_WEBHOOK_URL=

# ==========================================================================
# Stripe (integrations.stripe)
# gate: integrations.stripe
# ==========================================================================
# Revenue for the analytics dashboards. Read-only use: Stripe is the pricing
# source of truth and this app never writes to it.

# Restricted read key is enough.
# [required for this group]
STRIPE_SECRET_KEY=

# ==========================================================================
# Product analytics (feature: product_analytics)
# gate: features.product_analytics
# ==========================================================================
# The whole /dashboard suite: GA4, PostHog, Google Ads, Search Console, App
# Store Connect, Customer.io and the S3 export. This is the single largest
# group and it is entirely Wrenchlane-shaped today. A tenant without the
# feature needs none of it.

# Who may see the dashboards. Comma separated; a leading @domain matches the
# domain. AN EMPTY VALUE ALLOWS EVERYONE, which is a dev convenience and
# wrong in production.
# [optional]
CEO_ALLOWED_EMAILS=

# GA4 property behind the attribution sync.
# [required for this group]
GA4_PROPERTY_ID=

# Service account JSON for GA4 and Search Console.
# [required for this group]
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to the service account, for APIs that need a user.
# [optional]
GOOGLE_OAUTH_CLIENT_ID=

# Paired with the above.
# [optional]
GOOGLE_OAUTH_CLIENT_SECRET=

# Refresh token for that user.
# [optional]
GOOGLE_OAUTH_REFRESH_TOKEN=

# Redirect URI used when minting that token.
# [optional]
GOOGLE_OAUTH_REDIRECT_URI=

# Search Console property.
# [optional]
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# Older name for the same thing, still read.
# [optional]
SEARCH_CONSOLE_SITE_URL=

# Ads account the spend comes from.
# [required for this group]
GOOGLE_ADS_CUSTOMER_ID=

# Manager account id.
# [required for this group]
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Ads API developer token.
# [required for this group]
GOOGLE_ADS_DEVELOPER_TOKEN=

# For uploading offline conversions.
# [optional]
GOOGLE_DATAMANAGER_REFRESH_TOKEN=

# Conversion action for paid subscriptions. Run
# scripts/google-datamanager-setup.mjs to get it.
# [optional; read through a constant]
GOOGLE_ADS_PAID_SUBSCRIPTION_ACTION_ID=

# Currency for uploaded conversions.
# [optional]
GOOGLE_ADS_CURRENCY=

# Geo target constants for keyword ideas.
# [optional]
GOOGLE_ADS_GEO_TARGETS=

# Language constant for keyword ideas.
# [optional]
GOOGLE_ADS_LANGUAGE_CONSTANT=

# Turns the keyword-ideas call on.
# [optional]
GOOGLE_ADS_KEYWORD_IDEAS=

# Caps how many seeds are sent per request.
# [optional]
GOOGLE_ADS_IDEA_SEED_CAP=

# Personal API key for HogQL queries.
# [required for this group]
POSTHOG_API_KEY=

# PostHog project.
# [required for this group]
POSTHOG_PROJECT_ID=

# Defaults to the EU cloud host.
# [optional]
POSTHOG_API_HOST=

# Restricts which events the sync pulls.
# [optional]
POSTHOG_TRACKED_EVENTS=

# App API key. Reads and exports only.
# [required for this group]
CUSTOMER_IO_APP_API_KEY=

# us or eu.
# [optional]
CUSTOMER_IO_REGION=

# Override the metrics host.
# [optional]
CUSTOMER_IO_METRICS_ENDPOINT=

# App Store Connect key body.
# [optional]
APP_STORE_CONNECT_API_KEY=

# Key id.
# [optional]
APP_STORE_CONNECT_KEY_ID=

# Issuer id.
# [optional]
APP_STORE_CONNECT_ISSUER_ID=

# PEM private key.
# [optional]
APP_STORE_CONNECT_PRIVATE_KEY=

# Numeric app id.
# [optional]
APP_STORE_CONNECT_APPLE_ID=

# Bundle identifier.
# [optional]
APP_STORE_CONNECT_BUNDLE_ID=

# Pre-signed analytics report URL.
# [optional]
APP_STORE_CONNECT_ANALYTICS_REPORT_URL=

# Reads the customer-app S3 data export.
# [optional]
AWS_ACCESS_KEY_ID=

# Paired with the above.
# [optional]
AWS_SECRET_ACCESS_KEY=

# Region of that bucket.
# [optional]
AWS_REGION=

# Bucket name for the export.
# [optional]
DATA_BUCKET=

# ==========================================================================
# Reviews (feature: reviews)
# gate: features.reviews
# ==========================================================================
# App-store and public review collection. NOT stale, despite looking it:
# every one of these is read through getEnv(), which a search for
# `process.env.` does not find.

# Trustpilot public Business Units API key.
# [required for this group]
TRUSTPILOT_API_KEY=

# Pin the business unit id to skip the lookup.
# [optional]
TRUSTPILOT_BUSINESS_UNIT_ID=

# Domain used to resolve the business unit id.
# [optional]
TRUSTPILOT_DOMAIN=

# Set to 1 to turn Google Business Profile sync on. Dormant until that API
# access is approved; quota stays 0 until then.
# [optional]
GBP_REVIEWS_ENABLED=

# GBP account id.
# [optional]
GBP_ACCOUNT_ID=

# GBP location id.
# [optional]
GBP_LOCATION_ID=

# ==========================================================================
# Forums (feature: forums)
# gate: features.forums
# ==========================================================================
# Answering car-forum and Reddit threads. Needs APIFY_TOKEN as well.

# Must be the string 'true' to let the candidate scan run. Off by default
# because every firing costs an Apify run.
# [optional]
FORUM_CANDIDATE_SCAN_ENABLED=

# ==========================================================================
# Articles and Webflow (feature: articles)
# gate: features.articles
# ==========================================================================
# The content studio and its publishing target.

# Webflow site token.
# [required for this group]
WEBFLOW_API_TOKEN=

# Target site id.
# [required for this group]
WEBFLOW_SITE_ID=

# Mailbox the Releases tab imports from.
# [optional]
RELEASE_MAIL_MAILBOX=

# Gmail query that selects release mails.
# [optional]
RELEASE_MAIL_QUERY=

# ==========================================================================
# Fault codes (feature: dtc)
# gate: features.dtc
# ==========================================================================
# The DTC lookup calls the customer-facing diagnostics product. This is
# Wrenchlane's own API and no other tenant has one.

# Base URL of the diagnostics API.
# [required for this group]
WRENCHLANE_DIAGNOSTICS_API_URL=

# API key for it.
# [required for this group]
WRENCHLANE_DIAGNOSTICS_API_KEY=

# ==========================================================================
# Mockup (feature: mockup)
# gate: features.mockup
# ==========================================================================
# An internal page that embeds a clickable prototype.

# Overrides the built-in prototype URL.
# [optional]
NEXT_PUBLIC_MOCKUP_URL=

# ==========================================================================
# End-to-end tests
# gate: core
# ==========================================================================
# Only used by the Playwright suite. Never set in production.

# Account the e2e login route signs in as.
# [optional]
TEST_USER_EMAIL=

# ==========================================================================
# Injected by the platform
# gate: core
# ==========================================================================
# Listed so the drift check knows about them. Vercel and Node set these;
# setting them by hand is a mistake.

# development | production | test.
# [injected by the platform, do not set]
NODE_ENV=

# Deployment hostname Vercel injects.
# [injected by the platform, do not set]
VERCEL_URL=
